{
  "name": "lean-mcp",
  "version": "0.1.0",
  "description": "MCP server that compiles Lean 4 code locally and returns structured compiler feedback.",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "bin": {
    "lean-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "test": "node --test dist/test/parse.test.js",
    "test:integration": "node --test dist/test/integration.test.js",
    "check": "tsc -p tsconfig.json && node --test dist/test/parse.test.js && node scripts/smoke.mjs",
    "test:all": "npm run check && npm run test:integration && npm run smoke:call && npm run smoke:stress && npm run robustness",
    "smoke": "node scripts/smoke.mjs",
    "smoke:call": "node scripts/smoke-call.mjs",
    "smoke:stress": "node scripts/stress.mjs",
    "robustness": "node scripts/robustness.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}